/* =====================================================
   THE DIVES — JAVASCRIPT
   ===================================================== */


   /* =====================================================
      CONFIGURATION
      ===================================================== */

      const CORRECT_PASSCODE = "2603";


      /* =====================================================
         ELEMENTS
         ===================================================== */

         const lockerScreen =
           document.getElementById("lockerScreen");

           const introScreen =
             document.getElementById("introScreen");

             const archiveScreen =
               document.getElementById("archiveScreen");

               const certificatePage =
                 document.getElementById("certificatePage");

                 const displayText =
                   document.getElementById("displayText");

                   const lockStatus =
                     document.getElementById("lockStatus");

                     const keypadButtons =
                       document.querySelectorAll(".keypad button");

                       const enterArchive =
                         document.getElementById("enterArchive");

                         const backToIntro =
                           document.getElementById("backToIntro");

                           const restartArchive =
                             document.getElementById("restartArchive");

                             const diveButtons =
                               document.querySelectorAll(".dive-button");

                               const divePages =
                                 document.querySelectorAll(".dive-page");


                                 /* =====================================================
                                    STATE
                                    ===================================================== */

                                    let enteredCode = "";

                                    let currentDive = 1;


                                    /* =====================================================
                                       LOCKER DISPLAY
                                       ===================================================== */

                                       function updateDisplay() {

                                         if (enteredCode.length === 0) {
                                             displayText.textContent = "----";
                                                 return;
                                                   }

                                                     let hiddenCode = "";

                                                       for (let i = 0; i < enteredCode.length; i++) {
                                                           hiddenCode += "•";
                                                             }

                                                               displayText.textContent =
                                                                   hiddenCode.padEnd(4, "-");
                                                                   }


                                                                   /* =====================================================
                                                                      KEYPAD INPUT
                                                                      ===================================================== */

                                                                      keypadButtons.forEach(button => {

                                                                        button.addEventListener("click", () => {

                                                                            const key =
                                                                                  button.dataset.key;

                                                                                      if (key === "*" || key === "#") {

                                                                                            if (key === "*") {
                                                                                                    clearCode();
                                                                                                          }

                                                                                                                if (key === "#") {
                                                                                                                        checkCode();
                                                                                                                              }

                                                                                                                                    return;
                                                                                                                                        }


                                                                                                                                            if (enteredCode.length >= 4) {
                                                                                                                                                  return;
                                                                                                                                                      }


                                                                                                                                                          enteredCode += key;

                                                                                                                                                              updateDisplay();

                                                                                                                                                                  lockStatus.textContent =
                                                                                                                                                                        "ENTER PASSCODE";

                                                                                                                                                                            lockStatus.classList.remove(
                                                                                                                                                                                  "error",
                                                                                                                                                                                        "success"
                                                                                                                                                                                            );

                                                                                                                                                                                              });

                                                                                                                                                                                              });


                                                                                                                                                                                              /* =====================================================
                                                                                                                                                                                                 CLEAR CODE
                                                                                                                                                                                                 ===================================================== */

                                                                                                                                                                                                 function clearCode() {

                                                                                                                                                                                                   enteredCode = "";

                                                                                                                                                                                                     updateDisplay();

                                                                                                                                                                                                       lockStatus.textContent =
                                                                                                                                                                                                           "ENTER PASSCODE";

                                                                                                                                                                                                             lockStatus.classList.remove(
                                                                                                                                                                                                                 "error",
                                                                                                                                                                                                                     "success"
                                                                                                                                                                                                                       );

                                                                                                                                                                                                                       }


                                                                                                                                                                                                                       /* =====================================================
                                                                                                                                                                                                                          CHECK PASSCODE
                                                                                                                                                                                                                          ===================================================== */

                                                                                                                                                                                                                          function checkCode() {

                                                                                                                                                                                                                            if (enteredCode === CORRECT_PASSCODE) {

                                                                                                                                                                                                                                lockStatus.textContent =
                                                                                                                                                                                                                                      "ACCESS GRANTED";

                                                                                                                                                                                                                                          lockStatus.classList.remove("error");

                                                                                                                                                                                                                                              lockStatus.classList.add("success");

                                                                                                                                                                                                                                                  setTimeout(() => {

                                                                                                                                                                                                                                                        showScreen(
                                                                                                                                                                                                                                                                lockerScreen,
                                                                                                                                                                                                                                                                        introScreen
                                                                                                                                                                                                                                                                              );

                                                                                                                                                                                                                                                                                  }, 900);

                                                                                                                                                                                                                                                                                    } else {

                                                                                                                                                                                                                                                                                        lockStatus.textContent =
                                                                                                                                                                                                                                                                                              "ACCESS DENIED";

                                                                                                                                                                                                                                                                                                  lockStatus.classList.remove("success");

                                                                                                                                                                                                                                                                                                      lockStatus.classList.add("error");

                                                                                                                                                                                                                                                                                                          setTimeout(() => {

                                                                                                                                                                                                                                                                                                                clearCode();

                                                                                                                                                                                                                                                                                                                    }, 700);

                                                                                                                                                                                                                                                                                                                      }

                                                                                                                                                                                                                                                                                                                      }


                                                                                                                                                                                                                                                                                                                      /* =====================================================
                                                                                                                                                                                                                                                                                                                         SCREEN SWITCHING
                                                                                                                                                                                                                                                                                                                         ===================================================== */

                                                                                                                                                                                                                                                                                                                         function showScreen(oldScreen, newScreen) {

                                                                                                                                                                                                                                                                                                                           oldScreen.classList.remove("active");

                                                                                                                                                                                                                                                                                                                             newScreen.classList.add("active");

                                                                                                                                                                                                                                                                                                                               window.scrollTo({
                                                                                                                                                                                                                                                                                                                                   top: 0,
                                                                                                                                                                                                                                                                                                                                       behavior: "instant"
                                                                                                                                                                                                                                                                                                                                         });

                                                                                                                                                                                                                                                                                                                                         }


                                                                                                                                                                                                                                                                                                                                         /* =====================================================
                                                                                                                                                                                                                                                                                                                                            ENTER ARCHIVE
                                                                                                                                                                                                                                                                                                                                            ===================================================== */

                                                                                                                                                                                                                                                                                                                                            enterArchive.addEventListener("click", () => {

                                                                                                                                                                                                                                                                                                                                              showScreen(
                                                                                                                                                                                                                                                                                                                                                  introScreen,
                                                                                                                                                                                                                                                                                                                                                      archiveScreen
                                                                                                                                                                                                                                                                                                                                                        );

                                                                                                                                                                                                                                                                                                                                                          showDive(1);

                                                                                                                                                                                                                                                                                                                                                          });


                                                                                                                                                                                                                                                                                                                                                          /* =====================================================
                                                                                                                                                                                                                                                                                                                                                             BACK TO INTRO
                                                                                                                                                                                                                                                                                                                                                             ===================================================== */

                                                                                                                                                                                                                                                                                                                                                             backToIntro.addEventListener("click", () => {

                                                                                                                                                                                                                                                                                                                                                               showScreen(
                                                                                                                                                                                                                                                                                                                                                                   archiveScreen,
                                                                                                                                                                                                                                                                                                                                                                       introScreen
                                                                                                                                                                                                                                                                                                                                                                         );

                                                                                                                                                                                                                                                                                                                                                                         });


                                                                                                                                                                                                                                                                                                                                                                         /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                            DIVE NAVIGATION
                                                                                                                                                                                                                                                                                                                                                                            ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                            diveButtons.forEach(button => {

                                                                                                                                                                                                                                                                                                                                                                              button.addEventListener("click", () => {

                                                                                                                                                                                                                                                                                                                                                                                  const diveNumber =
                                                                                                                                                                                                                                                                                                                                                                                        Number(button.dataset.dive);

                                                                                                                                                                                                                                                                                                                                                                                            showDive(diveNumber);

                                                                                                                                                                                                                                                                                                                                                                                              });

                                                                                                                                                                                                                                                                                                                                                                                              });


                                                                                                                                                                                                                                                                                                                                                                                              /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                 SHOW DIVE
                                                                                                                                                                                                                                                                                                                                                                                                 ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                 function showDive(number) {

                                                                                                                                                                                                                                                                                                                                                                                                   currentDive = number;


                                                                                                                                                                                                                                                                                                                                                                                                     /* Hide every dive */

                                                                                                                                                                                                                                                                                                                                                                                                       divePages.forEach(page => {

                                                                                                                                                                                                                                                                                                                                                                                                           page.classList.remove("active");

                                                                                                                                                                                                                                                                                                                                                                                                             });


                                                                                                                                                                                                                                                                                                                                                                                                               /* Remove active navigation */

                                                                                                                                                                                                                                                                                                                                                                                                                 diveButtons.forEach(button => {

                                                                                                                                                                                                                                                                                                                                                                                                                     button.classList.remove("active");

                                                                                                                                                                                                                                                                                                                                                                                                                       });


                                                                                                                                                                                                                                                                                                                                                                                                                         /* Show selected page */

                                                                                                                                                                                                                                                                                                                                                                                                                           const selectedPage =
                                                                                                                                                                                                                                                                                                                                                                                                                               document.querySelector(
                                                                                                                                                                                                                                                                                                                                                                                                                                     `.dive-page[data-page="${number}"]`
                                                                                                                                                                                                                                                                                                                                                                                                                                         );

                                                                                                                                                                                                                                                                                                                                                                                                                                           const selectedButton =
                                                                                                                                                                                                                                                                                                                                                                                                                                               document.querySelector(
                                                                                                                                                                                                                                                                                                                                                                                                                                                     `.dive-button[data-dive="${number}"]`
                                                                                                                                                                                                                                                                                                                                                                                                                                                         );


                                                                                                                                                                                                                                                                                                                                                                                                                                                           if (selectedPage) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                               selectedPage.classList.add("active");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                 }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                   if (selectedButton) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                       selectedButton.classList.add("active");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                         }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                           certificatePage.classList.remove("active");


                                                                                                                                                                                                                                                                                                                                                                                                                                                                             window.scrollTo({
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 top: 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     behavior: "smooth"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       });


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         /* If Dive 6 is selected, add a small
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              delayed route toward the certificate
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   after the user reaches the bottom. */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     setupCertificateTrigger();

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        CERTIFICATE TRIGGER
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        function setupCertificateTrigger() {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          const existingButton =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              document.getElementById(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "finishDiveButton"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        );

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          if (existingButton) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              existingButton.remove();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if (currentDive !== 6) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          const diveSix =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              document.querySelector(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    '.dive-page[data-page="6"]'
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        );

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          if (!diveSix) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  const button =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      document.createElement("button");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        button.id =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "finishDiveButton";

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              button.className =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  "primary-button";

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    button.textContent =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "Continue to the Final Page ✦";


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          button.style.display =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              "block";

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                button.style.margin =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "35px auto 0";


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      diveSix.appendChild(button);


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        button.addEventListener("click", () => {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            diveSix.classList.remove("active");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                certificatePage.classList.add("active");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    window.scrollTo({
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          top: 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                behavior: "smooth"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    });

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      });

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         RESTART
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         restartArchive.addEventListener("click", () => {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           certificatePage.classList.remove("active");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             archiveScreen.classList.add("active");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               showDive(1);

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               });


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  KEYBOARD SUPPORT
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  document.addEventListener("keydown", event => {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    const key = event.key;


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      /* Number keys */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        if (/^[0-9]$/.test(key)) {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  lockerScreen.classList.contains("active") &&
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        enteredCode.length < 4
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ) {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  enteredCode += key;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        updateDisplay();

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                /* Clear */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if (key === "*") {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      if (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            lockerScreen.classList.contains("active")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ) {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      clearCode();

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              /* Enter / # */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    key === "Enter" ||
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        key === "#"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          ) {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              if (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    lockerScreen.classList.contains("active")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ) {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              checkCode();

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    });


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       MEMORY CARD MICRO-INTERACTION
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       document
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         .querySelectorAll(".memory-card")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           .forEach(card => {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               card.addEventListener(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     "mouseenter",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           () => {

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   card.style.setProperty(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             "--card-tilt",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       `${Math.random() * 2 - 1}deg`
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               );

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         );

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           });


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              INITIAL STATE
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              updateDisplay();

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              showDive(1); 