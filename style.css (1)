/* =====================================================
   THE DIVES — MASTER STYLESHEET
   ===================================================== */

   :root {
     --royal-blue: #4169E1;
       --sapphire: #2563EB;
         --deep-blue: #1D4ED8;
           --dark-navy: #1E3A8A;
             --midnight: #0F172A;
               --black: #000000;

                 --white: #f7f9ff;
                   --muted: #aeb8d4;

                     --glass: rgba(255, 255, 255, 0.07);
                       --glass-border: rgba(255, 255, 255, 0.14);

                         --transition: 0.45s cubic-bezier(.22, .61, .36, 1);
                         }


                         /* =====================================================
                            RESET
                            ===================================================== */

                            * {
                              margin: 0;
                                padding: 0;
                                  box-sizing: border-box;
                                  }

                                  html {
                                    scroll-behavior: smooth;
                                    }

                                    body {
                                      min-height: 100vh;
                                        background: #000;
                                          color: var(--white);
                                            font-family:
                                                Inter,
                                                    system-ui,
                                                        -apple-system,
                                                            BlinkMacSystemFont,
                                                                "Segoe UI",
                                                                    sans-serif;
                                                                      overflow-x: hidden;
                                                                      }

                                                                      button {
                                                                        font: inherit;
                                                                        }

                                                                        button:focus-visible {
                                                                          outline: 2px solid #fff;
                                                                            outline-offset: 4px;
                                                                            }


                                                                            /* =====================================================
                                                                               SCREEN SYSTEM
                                                                               ===================================================== */

                                                                               .screen {
                                                                                 min-height: 100vh;
                                                                                   display: none;
                                                                                   }

                                                                                   .screen.active {
                                                                                     display: flex;
                                                                                     }


                                                                                     /* =====================================================
                                                                                        LOCKER SCREEN
                                                                                        ===================================================== */

                                                                                        #lockerScreen {
                                                                                          align-items: center;
                                                                                            justify-content: center;
                                                                                              flex-direction: column;

                                                                                                background:
                                                                                                    linear-gradient(
                                                                                                          180deg,
                                                                                                                rgba(10, 10, 10, .35),
                                                                                                                      rgba(0, 0, 0, .92)
                                                                                                                          ),
                                                                                                                              #171717;

                                                                                                                                position: relative;
                                                                                                                                  overflow: hidden;
                                                                                                                                  }

                                                                                                                                  #lockerScreen::before {
                                                                                                                                    content: "";
                                                                                                                                      position: absolute;
                                                                                                                                        inset: 0;

                                                                                                                                          background-image:
                                                                                                                                              radial-gradient(
                                                                                                                                                    rgba(255,255,255,.06) 1px,
                                                                                                                                                          transparent 1px
                                                                                                                                                              );

                                                                                                                                                                background-size: 5px 5px;
                                                                                                                                                                  opacity: .12;
                                                                                                                                                                    pointer-events: none;
                                                                                                                                                                    }


                                                                                                                                                                    /* =====================================================
                                                                                                                                                                       WOODEN CABINET
                                                                                                                                                                       ===================================================== */

                                                                                                                                                                       .locker-cabinet {
                                                                                                                                                                         width: min(92vw, 850px);
                                                                                                                                                                           padding: 48px;

                                                                                                                                                                             background:
                                                                                                                                                                                 linear-gradient(
                                                                                                                                                                                       90deg,
                                                                                                                                                                                             #2a1710,
                                                                                                                                                                                                   #51301f 50%,
                                                                                                                                                                                                         #25130d
                                                                                                                                                                                                             );

                                                                                                                                                                                                               border-radius: 8px;

                                                                                                                                                                                                                 box-shadow:
                                                                                                                                                                                                                     0 40px 80px rgba(0,0,0,.75),
                                                                                                                                                                                                                         inset 0 0 30px rgba(0,0,0,.55);
                                                                                                                                                                                                                         }


                                                                                                                                                                                                                         /* =====================================================
                                                                                                                                                                                                                            SAFE
                                                                                                                                                                                                                            ===================================================== */

                                                                                                                                                                                                                            .locker {
                                                                                                                                                                                                                              background:
                                                                                                                                                                                                                                  linear-gradient(
                                                                                                                                                                                                                                        145deg,
                                                                                                                                                                                                                                              #282a2c,
                                                                                                                                                                                                                                                    #151617
                                                                                                                                                                                                                                                        );

                                                                                                                                                                                                                                                          padding: 16px;

                                                                                                                                                                                                                                                            border-radius: 10px;

                                                                                                                                                                                                                                                              box-shadow:
                                                                                                                                                                                                                                                                  inset 0 2px 3px rgba(255,255,255,.08),
                                                                                                                                                                                                                                                                      inset 0 -8px 20px rgba(0,0,0,.5),
                                                                                                                                                                                                                                                                          0 25px 45px rgba(0,0,0,.7);
                                                                                                                                                                                                                                                                          }

                                                                                                                                                                                                                                                                          .locker-door {
                                                                                                                                                                                                                                                                            position: relative;
                                                                                                                                                                                                                                                                              min-height: 480px;

                                                                                                                                                                                                                                                                                background:
                                                                                                                                                                                                                                                                                    linear-gradient(
                                                                                                                                                                                                                                                                                          145deg,
                                                                                                                                                                                                                                                                                                #26282a,
                                                                                                                                                                                                                                                                                                      #171819
                                                                                                                                                                                                                                                                                                          );

                                                                                                                                                                                                                                                                                                            border: 2px solid #111;
                                                                                                                                                                                                                                                                                                              border-radius: 7px;

                                                                                                                                                                                                                                                                                                                box-shadow:
                                                                                                                                                                                                                                                                                                                    inset 0 0 0 4px #202224,
                                                                                                                                                                                                                                                                                                                        inset 0 0 30px rgba(0,0,0,.65);
                                                                                                                                                                                                                                                                                                                        }


                                                                                                                                                                                                                                                                                                                        /* =====================================================
                                                                                                                                                                                                                                                                                                                           SAFE BRANDING
                                                                                                                                                                                                                                                                                                                           ===================================================== */

                                                                                                                                                                                                                                                                                                                           .brand {
                                                                                                                                                                                                                                                                                                                             position: absolute;
                                                                                                                                                                                                                                                                                                                               top: 25px;
                                                                                                                                                                                                                                                                                                                                 left: 28px;

                                                                                                                                                                                                                                                                                                                                   font-size: 17px;
                                                                                                                                                                                                                                                                                                                                     font-weight: 800;
                                                                                                                                                                                                                                                                                                                                       letter-spacing: 4px;

                                                                                                                                                                                                                                                                                                                                         color: #f5f5f5;
                                                                                                                                                                                                                                                                                                                                         }

                                                                                                                                                                                                                                                                                                                                         .certification {
                                                                                                                                                                                                                                                                                                                                           position: absolute;
                                                                                                                                                                                                                                                                                                                                             top: 23px;
                                                                                                                                                                                                                                                                                                                                               right: 27px;

                                                                                                                                                                                                                                                                                                                                                 width: 30px;
                                                                                                                                                                                                                                                                                                                                                   height: 30px;

                                                                                                                                                                                                                                                                                                                                                     border: 2px solid #bbb;
                                                                                                                                                                                                                                                                                                                                                       border-radius: 50%;

                                                                                                                                                                                                                                                                                                                                                         display: grid;
                                                                                                                                                                                                                                                                                                                                                           place-items: center;

                                                                                                                                                                                                                                                                                                                                                             font-size: 13px;
                                                                                                                                                                                                                                                                                                                                                               color: #ddd;
                                                                                                                                                                                                                                                                                                                                                               }


                                                                                                                                                                                                                                                                                                                                                               /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                  LOCK FACEPLATE
                                                                                                                                                                                                                                                                                                                                                                  ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                  .faceplate {
                                                                                                                                                                                                                                                                                                                                                                    position: absolute;

                                                                                                                                                                                                                                                                                                                                                                      width: min(88%, 520px);

                                                                                                                                                                                                                                                                                                                                                                        left: 50%;
                                                                                                                                                                                                                                                                                                                                                                          top: 52%;

                                                                                                                                                                                                                                                                                                                                                                            transform: translate(-50%, -50%);

                                                                                                                                                                                                                                                                                                                                                                              padding: 28px 28px 24px 60px;

                                                                                                                                                                                                                                                                                                                                                                                background:
                                                                                                                                                                                                                                                                                                                                                                                    linear-gradient(
                                                                                                                                                                                                                                                                                                                                                                                          145deg,
                                                                                                                                                                                                                                                                                                                                                                                                #08090a,
                                                                                                                                                                                                                                                                                                                                                                                                      #17191b
                                                                                                                                                                                                                                                                                                                                                                                                          );

                                                                                                                                                                                                                                                                                                                                                                                                            border: 1px solid #303235;

                                                                                                                                                                                                                                                                                                                                                                                                              border-radius: 5px;

                                                                                                                                                                                                                                                                                                                                                                                                                box-shadow:
                                                                                                                                                                                                                                                                                                                                                                                                                    0 12px 25px rgba(0,0,0,.55),
                                                                                                                                                                                                                                                                                                                                                                                                                        inset 0 1px 0 rgba(255,255,255,.05);
                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                        .red-accent {
                                                                                                                                                                                                                                                                                                                                                                                                                          position: absolute;
                                                                                                                                                                                                                                                                                                                                                                                                                            left: 0;
                                                                                                                                                                                                                                                                                                                                                                                                                              top: 0;
                                                                                                                                                                                                                                                                                                                                                                                                                                bottom: 0;

                                                                                                                                                                                                                                                                                                                                                                                                                                  width: 48px;

                                                                                                                                                                                                                                                                                                                                                                                                                                    background:
                                                                                                                                                                                                                                                                                                                                                                                                                                        linear-gradient(
                                                                                                                                                                                                                                                                                                                                                                                                                                              145deg,
                                                                                                                                                                                                                                                                                                                                                                                                                                                    #ff3547,
                                                                                                                                                                                                                                                                                                                                                                                                                                                          #b70d1b
                                                                                                                                                                                                                                                                                                                                                                                                                                                              );

                                                                                                                                                                                                                                                                                                                                                                                                                                                                clip-path: polygon(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    0 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        100% 0,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            70% 25%,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                100% 50%,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    70% 75%,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        100% 100%,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            0 100%
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              );
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 DIGITAL DISPLAY
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 .display {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   height: 62px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     display: flex;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       align-items: center;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         justify-content: center;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           margin-bottom: 20px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             background: #020202;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               border: 3px solid #202124;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 border-radius: 3px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   box-shadow:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       inset 0 0 18px rgba(0,0,0,.9),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           0 0 8px rgba(255,0,30,.08);

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             overflow: hidden;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             #displayText {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               color: #ff2a3b;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 font-family:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     "Courier New",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         monospace;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           font-size: 31px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             font-weight: bold;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               letter-spacing: 8px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 text-shadow:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     0 0 5px #ff2a3b,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         0 0 15px rgba(255,42,59,.6);

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           min-width: 180px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             text-align: center;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                KEYPAD
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .keypad {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  display: grid;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    grid-template-columns:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        repeat(3, 1fr);

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          gap: 7px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          .keypad button {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            height: 48px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              border: 1px solid #777;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                background:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    linear-gradient(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          145deg,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                #f1f0eb,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      #c9c7c0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          );

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            color: #161616;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              border-radius: 2px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                cursor: pointer;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  font-weight: 700;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    transition:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        transform .12s ease,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            filter .12s ease;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            .keypad button:hover {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              filter: brightness(1.08);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              .keypad button:active {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                transform: translateY(2px);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   LOCK STATUS
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   .lock-status {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     margin-top: 17px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       text-align: center;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         font-size: 10px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           letter-spacing: 3px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             color: #777;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               transition: .3s ease;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               .lock-status.error {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 color: #ff4052;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 .lock-status.success {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   color: #62a4ff;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      LOCKER HINT
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      .locker-hint {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        margin-top: 22px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          color: #707070;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            font-size: 12px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              letter-spacing: 3px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                text-transform: uppercase;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }


                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                /* =====================================================
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   INTRO SCREEN
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   ===================================================== */

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   #introScreen {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     align-items: center;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       justify-content: center;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         text-align: center;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           background:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               radial-gradient(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     circle at center,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           rgba(65,105,225,.24),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 transparent 45%
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     ),
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         linear-gradient(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               to bottom,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     #4169E1,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           #2563EB,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 #1D4ED8,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       #1E3A8A,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             #0F172A,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   #000000
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       );

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         position: relative;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         .intro-content {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           width: min(90%, 650px);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             padding: 50px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             .intro-symbol {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               font-size: 38px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 margin-bottom: 25px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   animation: floatSymbol 4s ease-in-out infinite;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   .eyebrow {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     font-size: 10px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       letter-spacing: 5px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         color: #b9c8ff;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           text-transform: uppercase;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           .intro-content h1 {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             margin-top: 12px;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               font-family: Georgia, serif;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 font-size: clamp(52px, 10vw, 100px);

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   font-weight: 400;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     letter-spacing: -3px;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     .intro-text {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       max-width: 520px;

